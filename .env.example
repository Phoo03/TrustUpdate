# Database Dialect: mysql | sqlite
DB_DIALECT=mysql

# MySQL Configuration (when DB_DIALECT=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=trustupdate
DB_USER=root
DB_PASS=

# JWT Secret – use a strong, randomly generated string in production (at least 64 chars)
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars

# JWT expiry (e.g. 1h, 8h, 1d)
JWT_EXPIRES_IN=8h

# Server Port
PORT=5000

# Node Environment: development | production | test
NODE_ENV=development

# Seed User Initial Setup (optional: if omitted, random passwords are generated on first seed run)
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=replace_with_strong_admin_password
SEED_VIEWER_USER=viewer
SEED_VIEWER_PASSWORD=replace_with_strong_viewer_password

# Max file upload size in bytes (500 MB)
MAX_FILE_SIZE=524288000

# Rate-limit: max requests per window per IP on auth/verify routes
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
